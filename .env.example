# Copy this file to .env, then replace every CHANGE_ME value before deployment.
POSTGRES_DB=doctor_management
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

DATABASE_URL=postgresql+psycopg://dms_user:CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/doctor_management
SECRET_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_KEY_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000

# The backend creates this initial administrator only when both values are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SEED_DEMO_DATA=false
